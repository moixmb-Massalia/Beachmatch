rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: vérifie si l'utilisateur est l'admin
    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'moixmb@gmail.com';
    }

    // TERRAINS : lecture libre pour tout le monde
    // Création possible par tout utilisateur connecté (suggestion de terrain)
    // Modification et suppression : admin seulement
    match /courts/{courtId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // OBJETS PERDUS/TROUVÉS sur un terrain (sous-collection)
    // Lecture et création par tout utilisateur connecté
    // Suppression : admin seulement
    match /courts/{courtId}/lost_and_found/{itemId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow delete: if isAdmin();
    }

    // UTILISATEURS
    // Lecture par tout utilisateur connecté (pour voir les profils publics)
    // Écriture uniquement sur son propre document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // MATCHS
    // Lecture par tout utilisateur connecté
    // Création : l'utilisateur doit être le hostId
    // Modification : le host peut tout modifier, les autres uniquement participantsIds
    // Suppression : le host seulement
    match /matches/{matchId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.hostId == request.auth.uid;
      allow update: if request.auth != null && (
        resource.data.hostId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participantsIds'])
      );
      allow delete: if request.auth != null && resource.data.hostId == request.auth.uid;
    }

    // CHATS (messagerie privée et groupes)
    // Lecture : l'utilisateur doit faire partie du tableau 'users'
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
    }

    match /chats/{chatId}/messages/{messageId} {
      // Pour lire/écrire un message, il faut faire partie des participants (users) du parent chat
      // Pour éviter de bloquer, on permet la lecture et création si auth!=null. 
      allow read, write: if request.auth != null;
    }

    // SIGNALEMENTS
    // Création par l'utilisateur lui-même seulement
    // Lecture : admin seulement (pour pouvoir traiter les signalements)
    // Modification / suppression : personne (immutable une fois créé)
    match /reports/{reportId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.reporterId;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    // ACTUALITÉS / VIDÉOS
    // Lecture libre pour tous
    // Écriture : admin seulement
    match /news/{newsId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // TOURNOIS
    // Lecture libre pour tous
    // Création / modification : utilisateurs connectés (Présidents de clubs, Arbitres, Admin)
    // Suppression : créateur ou admin
    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null;

      match /bracket/{bracketId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /brackets/{bracketId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /live_matches/{matchId} {
        allow read: if true;
        allow write: if request.auth != null;
      }

      match /court_calls/{callId} {
        allow read, write: if true;
      }

      match /bets/{betId} {
        allow read, write: if request.auth != null;
      }
    }

    // CLASSEMENTS FFT
    // Lecture libre pour tous (pour la recherche de joueurs et classements)
    // Écriture : uniquement via les scripts admin / SDK
    match /fft_rankings/{id} {
      allow read: if true;
      allow write: if false;
    }

    // SOS PARTENAIRE TOURNOI (MATCHMAKING DOUBLE)
    // Lecture libre pour tous
    // Création par utilisateur connecté
    // Modification / suppression par l'auteur ou admin
    match /tournament_partner_requests/{requestId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // PROPOSITIONS DE PARTENARIAT (envoyées via bouton "Faire équipe")
    // Création par utilisateur connecté
    // Lecture par l'expéditeur ou le destinataire
    // Suppression par l'expéditeur
    match /partner_proposals/{proposalId} {
      allow read: if request.auth != null && (
        resource.data.senderId == request.auth.uid ||
        resource.data.targetUserId == request.auth.uid
      );
      allow create: if request.auth != null;
      allow delete: if request.auth != null && resource.data.senderId == request.auth.uid;
      allow update: if false;
    }

    // CLUBS
    // Lecture par tout utilisateur connecté
    match /clubs/{clubId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null; // On permet aux users de s'ajouter aux membres (memberIds)
    }

    // PUBLICATIONS DE CLUBS
    // Lecture par tout utilisateur connecté
    // Création par n'importe qui (mais le code restreint le bouton à l'admin pour l'instant)
    match /club_posts/{postId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

    // BEACHSCORE WORLD TOUR (ITF / FFT PRO TOURNAMENTS & MATCHES)
    // Lecture libre pour tous (style FlashScore / SofaScore)
    // Écriture : admin ou Cloud Functions
    match /pro_tournaments/{tournamentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pro_matches/{matchId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /live_matches/{matchId} {
      allow read: if true;
      allow write: if request.auth != null; // Permet aux arbitres de mettre à jour les scores
    }

    // SUGGESTIONS DE TERRAINS
    match /court_suggestions/{suggestionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
      allow update, delete: if isAdmin();
    }

    // NOTIFICATIONS & ALERTES CLUBS
    match /notifications/{notificationId} {
      allow read, write: if request.auth != null;
    }
  }
}
